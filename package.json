{
  "name": "dsh-better-plugin-updater",
  "version": "0.1.0",
  "description": "Manual multi-source update checks and update plans for DeepSeek Harness plugin bundles.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "node": "./dist/client/index.js",
      "browser": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.4 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mooling0602/dsh-better-plugin-updater.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "semver": "^7.7.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
